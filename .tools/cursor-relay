#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: .tools/cursor-relay pm|engineer|qa <task> | --prompt-file <path>" >&2
  exit 2
}

[[ $# -ge 2 ]] || usage
role=$1
shift

if [[ $# -eq 1 && $1 != --prompt-file ]]; then
  task=$1
elif [[ $# -eq 2 && $1 == --prompt-file ]]; then
  [[ -f $2 && -r $2 ]] || {
    echo "BLOCKED: prompt file is missing or unreadable: $2" >&2
    exit 1
  }
  task=$(< "$2")
else
  usage
fi
[[ -n $task ]] || usage

case "$role" in
  pm)
    backend=acp
    model=cursor-grok-4.6-high-fast
    role_doc=_docs/team/pm.md
    approval=(--approval reject)
    ;;
  engineer)
    backend=cli
    model=cursor-grok-4.6-xhigh
    role_doc=_docs/team/engineer.md
    approval=()
    ;;
  qa)
    backend=acp
    model=cursor-grok-4.6-high-fast
    role_doc=_docs/team/qa.md
    approval=(--approval reject)
    ;;
  *) usage ;;
esac

if ! command -v cursor-relay >/dev/null 2>&1; then
  echo "BLOCKED: local cursor-relay prototype is not on PATH." >&2
  exit 127
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
printf -v prompt 'Read AGENTS.md, _docs/process.md, _docs/decisions.md, and %s. Follow the assigned role only.\n\n%s' "$role_doc" "$task"

exec cursor-relay \
  --backend "$backend" \
  --workspace "$repo_root" \
  --model "$model" \
  "${approval[@]}" \
  --prompt "$prompt"
